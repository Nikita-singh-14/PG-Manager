# Copy to .env (project root) and edit. Never commit .env.
# MongoDB connection string. Local: mongodb://127.0.0.1:27017/pg_manager  | Atlas: mongodb+srv://user:pass@cluster/pg_manager
MONGODB_URI=mongodb://127.0.0.1:27017/pg_manager
# Optional: a separate MongoDB URI for tests. If empty, tests download and use mongodb-memory-server.
MONGODB_URI_TEST=
# API port
PORT=5000
# Secret used to sign login tokens. REQUIRED in production: openssl rand -hex 32
JWT_SECRET=change-me-to-a-long-random-string
# Hours a login token stays valid
TOKEN_TTL_HOURS=12
# Browser origin allowed to call the API when the client runs separately (Vite dev server)
CLIENT_ORIGIN=http://localhost:5173
# Day of month on which monthly rent falls due (1-28)
RENT_DUE_DAY=5
# IANA timezone used to decide what "today" is
APP_TIMEZONE=Asia/Kolkata
# development | production
NODE_ENV=development
